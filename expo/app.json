{
  "expo": {
    "name": "Clairity",
    "slug": "clairity-health",
    "owner": "syxxn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clarity-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.clairity.health",
      "buildNumber": "20",
      "infoPlist": {
        "NSCameraUsageDescription": "CLAIRITY uses the camera so you can photograph a medical document or your health card. The photo is used only to read and explain that document and is stored on your device.",
        "NSPhotoLibraryUsageDescription": "CLAIRITY needs access to your photo library so you can choose an existing photo of a medical document or health card to explain or save.",
        "NSFaceIDUsageDescription": "CLAIRITY uses Face ID so that only you can unlock and view your saved health card.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FAF6F0"
      },
      "package": "app.clairity.health",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "versionCode": 20
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CLAIRITY to use your location only when you choose to fill an appointment location."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2A2119"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 132,
          "resizeMode": "contain",
          "backgroundColor": "#FAF6F0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6253d23-fad6-4a9c-b73f-40138ac69163"
      }
    }
  }
}
