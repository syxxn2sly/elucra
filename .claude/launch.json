{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8099",
        "--directory",
        "site"
      ],
      "port": 8099
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start-web"
      ],
      "port": 8081,
      "cwd": "expo"
    }
  ]
}
